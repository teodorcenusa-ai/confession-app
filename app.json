{
  "expo": {
    "name": "Taina Spovedaniei",
    "slug": "confession-app",
    "version": "1.1.8",
    "scheme": "taina-spovedaniei",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ro.teodor.taina.spovedanie"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "ro.teodor.taina.spovedanie",
      "versionCode": 18,
      "targetSdkVersion": 36
    },
    "extra": {
      "eas": {
        "projectId": "8e786eca-e5fe-4db4-9473-48f542c62711"
      }
    },
    "owner": "teodorash",
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "ndkVersion": "27.1.12297006",
            "packagingOptions": {
              "useLegacyPackaging": false
            }
          }
        }
      ]
    ]
  }
}