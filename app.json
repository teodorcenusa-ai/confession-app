{
  "expo": {
    "name": "Taina Spovedaniei",
    "slug": "confession-app",
    "version": "1.2.1",
    "scheme": "taina-spovedaniei",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ro.teodor.taina.spovedanie",
      "buildNumber": "4",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "ro.teodor.taina.spovedanie",
      "versionCode": 22
    },
    "extra": {
      "eas": {
        "projectId": "8e786eca-e5fe-4db4-9473-48f542c62711"
      }
    },
    "owner": "teodorash",
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff"
        }
      ],
      "expo-sharing",
      "expo-router",
      "expo-splash-screen",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}